{
  "name": "todo-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Private claude.ai Artifact page for TODO.md plus the todo-sync CLI",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "todo-sync": "bin/todo-sync.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:acceptance": "node --test \"tests/acceptance/*.test.js\" && playwright test",
    "test:acceptance:cli": "node --test \"tests/acceptance/*.test.js\"",
    "test:acceptance:page": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
